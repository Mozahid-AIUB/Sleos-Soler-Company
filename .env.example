# Copy to .env.local for local development. In production set these in
# Coolify -> OSLEOS -> Environment Variables (never commit real keys).

# AI assistant (/api/chat). Set at least one key; providers are tried in this order and the first that answers wins:
# GROQ_API_KEY=          (free tier, https://console.groq.com)  GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_API_KEY=        (free tier, https://aistudio.google.com/apikey)  GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER_ORDER=groq,gemini,anthropic

# Anthropic API key for the website AI assistant (/api/chat).
# Leave empty to disable the assistant: the chat widget then falls back to WhatsApp.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-sonnet-5-5).
# ANTHROPIC_MODEL=

# SEO / tracking (all optional; the feature is skipped when empty).
# Set these in Coolify as BUILD variables too: the pages are generated at build time.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID, digits only
# NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console "HTML tag" verification: the content="..." value only
# GOOGLE_SITE_VERIFICATION=
